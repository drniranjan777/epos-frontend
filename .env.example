# Base URL of the API. Keep the default when the frontend and API share a domain
# (nginx proxies /api to the backend). Use a full URL only for a separate API domain.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server proxies /api and /uploads.
VITE_DEV_API_TARGET=http://localhost:5000

VITE_APP_NAME=JCB Parts Inventory
